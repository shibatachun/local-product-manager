  <ActionGroup ID="853c20b5-ed80-4b50-ae2d-a4ea40ded0a8" RunMethod="Sequential" MessagingEnabled="false">
    <Actions>
      <WebRequestIntegration Name="Local Product Manager Label Printing" IgnoreErrors="true" ID="aae70274-db6b-40b5-b28f-99f15223063d" ActionExecution="WaitForPreviousEventPrintJob" Port="5160" ServiceName="lpm-label-print" ResponseFormat="Json">
        <Description>Print BID and inventory labels from Local Product Manager</Description>
        <Variables>
          <Variable Name="action" Type="System.String">
            <Value>print</Value>
          </Variable>
          <Variable Name="copies" Type="System.String">
            <Value>1</Value>
          </Variable>
          <Variable Name="recordId" Type="System.String">
            <Value>BID|B000001|P010</Value>
          </Variable>
        </Variables>
        <ActionGroup ID="5f0cf21c-cba0-4390-8ad3-f4f1e1de0ab1" RunMethod="Sequential" MessagingEnabled="false">
          <Actions>
            <PrintAction Name="Print Document" RunType="UseConditionVariable" IgnoreErrors="false" ID="c613fdd6-dae8-43cc-b901-f03d5fc6b8c1" CloseDocumentAfterPrint="true" CopiesPerSerialNumber="%copies%">
              <ConditionExpression>
                <Expression>[%action%] = 'print'</Expression>
                <VariableDataTypes>{"action":"Text"}</VariableDataTypes>
              </ConditionExpression>
              <DocumentFile Path="C:\Users\jjgqa\local-product-manager\label_format_localdatabaseConnected.btw">
                <FileSystem.System />
              </DocumentFile>
              <QueryPrompts Name="BID_UUID" Value="%recordId%" />
              <PrintToFileFolder Path="%IntegrationFileNameWithoutExtension%">
                <FileSystem.Temporary />
              </PrintToFileFolder>
            </PrintAction>
          </Actions>
        </ActionGroup>
