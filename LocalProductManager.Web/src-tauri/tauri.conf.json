{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalProductManager",
  "version": "0.1.0",
  "identifier": "com.localproductmanager.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/LocalProductManager.Web/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalProductManager",
        "url": "https://inventory.jjgqaz.com:7265",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Local inventory and product management",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
