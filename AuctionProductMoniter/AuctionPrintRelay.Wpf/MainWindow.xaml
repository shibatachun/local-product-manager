<Window x:Class="AuctionPrintRelay.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Auction Print Relay" Height="620" Width="800" MinHeight="520" MinWidth="680" Background="#F5F7FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Auction Print Relay" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="接收主播电脑请求并转发到本机 BarTender Integration" Foreground="#667085" Margin="0,4,0,0"/></StackPanel>
  <Border Grid.Row="1" Margin="0,16,0,12" Padding="12" Background="#E8F7EE" CornerRadius="8"><TextBlock x:Name="StatusText" Text="正在启动…" Foreground="#14532D"/></Border>
  <Border Grid.Row="2" Padding="12" Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel>
   <TextBlock Text="局域网请求地址" FontWeight="SemiBold"/><TextBox x:Name="AddressBox" IsReadOnly="True" Padding="7" Margin="0,6,0,8"/>
   <TextBlock Text="访问密钥" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,8"><Button Content="复制" Click="CopyKey_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6"/><TextBox x:Name="KeyBox" IsReadOnly="True" Padding="7"/></DockPanel>
   <TextBlock Text="本机 BarTender Integration 地址" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,0"><Button Content="保存并测试" Click="SaveTest_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6"/><TextBox x:Name="EndpointBox" Padding="7"/></DockPanel>
  </StackPanel></Border>
  <TextBlock Grid.Row="3" Text="请求记录" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
  <DataGrid Grid.Row="4" x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="170"/><DataGridTextColumn Header="买家" Binding="{Binding Buyer}" Width="*"/><DataGridTextColumn Header="商品编号" Binding="{Binding Product}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="230"/></DataGrid.Columns></DataGrid>
 </Grid>
</Window>
