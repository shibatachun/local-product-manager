{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalProductManager",
  "version": "0.1.4",
  "identifier": "com.localproductmanager.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/LocalProductManager.Web/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalProductManager",
        "url": "https://192.168.0.160",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Local inventory and product management",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNUFDQzlBQTk1QzYwQzgKUldUSVlGeXBtc3hhSWJ4MExFWlpnbzF2bXJ2WmdoRTFQS0RBTVpwZTcwUmp0MDBpdWZZYUVWZUUK",
      "endpoints": [
        "https://192.168.0.160/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
