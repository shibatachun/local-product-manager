{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/local-product-manager.db"
  },
  "ImageStorage": {
    "AllowedRoots": [
      "Data\\Images",
      "D:\\Products",
      "\\\\IMAGE-COMPUTER\\ProductImages"
    ]
  },
  "YouTubeOAuth": {
    "RedirectUri": "http://localhost:5077/api/youtube/oauth/callback"
  },
  "PinterestOAuth": {
    "RedirectUri": "http://localhost:5077/api/pinterest/oauth/callback",
    "Scopes": "user_accounts:read,pins:read,boards:read"
  },
  "MetaOAuth": {
    "RedirectUri": "http://localhost:5077/api/meta/oauth/callback",
    "GraphVersion": "v20.0",
    "Scopes": "pages_show_list,pages_read_engagement,pages_read_user_content,read_insights,instagram_basic,instagram_manage_insights"
  },
  "AiAnalysis": {
    "GeminiModel": "gemini-3.1-flash-lite"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
